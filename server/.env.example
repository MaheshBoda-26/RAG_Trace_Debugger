# RAG Trace Debugger — server environment
# Copy to server/.env and fill in if you want live Gemini calls.
# All keys are OPTIONAL: the demo runs end-to-end with deterministic fallbacks.

# Google Gemini API key. When unset, retrieval falls back to BM25-only
# (no dense embeddings) and generation falls back to a deterministic mock.
GEMINI_API_KEY=

# Model / embedding identifiers (defaults shown).
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Server
HOST=127.0.0.1
PORT=8000
