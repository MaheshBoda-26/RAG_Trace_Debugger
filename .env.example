# RAG Trace Debugger — Docker Compose environment
# Copy to .env and fill in if you want live Gemini calls.
# All keys are OPTIONAL: the demo runs end-to-end with deterministic fallbacks.

# Google Gemini API key. When unset, retrieval falls back to BM25-only
# (no dense embeddings) and generation falls back to a deterministic mock.
GEMINI_API_KEY=
